# Server Configuration
PORT=5000

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/Alerto
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/Alerto?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/Alerto

# JWT Secret Key (change this to a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
