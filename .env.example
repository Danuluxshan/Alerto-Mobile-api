# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
# MongoDB connection string
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Example: mongodb://localhost:27017/Alerto
# Example with auth: mongodb://user:pass@localhost:27017/Alerto?authSource=admin
MONGO_URI=mongodb://localhost:27017/Alerto

# JWT Configuration
# Secret key for signing JWT tokens
# Generate a strong random string for production (e.g., use: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
# Port number for the backend server
PORT=5000

# Environment
# Set to 'development', 'staging', or 'production'
NODE_ENV=development

# Frontend URL
# URL of the frontend application for CORS configuration
# For development: http://localhost:8081 or http://192.168.1.55:8081
# For production: https://yourdomain.com
FRONTEND_URL=http://localhost:8081

# Firebase Configuration (for Push Notifications)
# These are required for Firebase Cloud Messaging
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Note: FIREBASE_PRIVATE_KEY must include \n characters for newlines
# Wrap the entire private key in double quotes

# SMTP Configuration (for Email Notifications)
# Required for sending help/support emails
# For Gmail: Use App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-email-password
